# ============================================================================
# HybEx-Law .gitignore - Deployment Ready
# ============================================================================

# Environment Variables & Secrets (CRITICAL - NEVER COMMIT!)
.env
.env.local
.env.*.local
*.env
secrets.toml
.streamlit/secrets.toml

# API Keys & Credentials
*_api_key*
*_secret*
*_token*
credentials.json
config_private.py

# Log files
*.log
logs/
multi_domain_legal/logs/
*.log.*

# Models (too large for Git - use Git LFS or cloud storage)
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.pickle
models/
checkpoints/

# Results & Outputs
results/
outputs/
*.csv
*.json
!data/*.json  # Keep data files
!models/**/*.json  # Keep model metadata

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Temporary files
*.tmp
*.temp
temp/
tmp/
.cache/

# OS-specific
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini